# Copiar como .env y completar (el .env real NUNCA se sube a GitHub)
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# En EC2 agregar: CSRF_TRUSTED_ORIGINS=http://IP_PUBLICA,https://tu-dominio
CSRF_TRUSTED_ORIGINS=

# Base de datos (DB_ENGINE=mysql | sqlite)
DB_ENGINE=mysql
DB_NAME=municipalidad_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Correo (recuperación de contraseña)
# Desarrollo: console (el correo se imprime en la terminal)
# Producción: smtp (ej. Gmail con "contraseña de aplicación")
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Municipalidad La Serena <no-reply@laserena.cl>
